{
  "name": "herdr-bridge-web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "npx --yes --package=openapi-typescript@7.6.1 openapi-typescript ../contracts/openapi.yaml -o src/api.generated.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/react-query": "5.101.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "marked": "file:vendor/marked-16.4.2.tgz",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-resizable-panels": "4.11.1",
    "react-router-dom": "7.17.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vitest": "4.0.18"
  }
}
